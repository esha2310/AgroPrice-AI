# These are environment variables, not a file Django automatically reads.
DEBUG=0
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DATA_DIR=/var/lib/agroprice
# Enable only when your controlled proxy strips incoming spoofed headers:
TRUST_PROXY=0
